---
/** Tag (Kind=Pill): bordered uppercase label, used for project tags and socials. */
interface Props {
  label: string;
  /** Renders a link when set; a plain span otherwise (no dead links). */
  href?: string;
}

const { label, href } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element class="tag" href={href}>{label}</Element>

<style lang="scss">
  @use '../styles/mixins' as *;

  .tag {
    @include text-label;
    display: inline-flex;
    padding: 7px 14px;
    color: rgba(237, 241, 244, 0.86);
    white-space: nowrap;
    border: 1px solid rgba(237, 241, 244, 0.28);
    border-radius: 999px;
  }

  a.tag {
    transition: border-color 0.3s;

    &:hover {
      border-color: rgba(237, 241, 244, 0.55);
    }
  }
</style>
