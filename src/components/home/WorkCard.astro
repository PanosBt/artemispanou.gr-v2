---
/** Card/Work Slide: one featured case study in the Selected Work carousel. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Marquee from '../Marquee.astro';
import Tag from '../Tag.astro';
import ArrowIcon from '../../assets/icons/arrow-up-right.svg';
import { formatCount } from '../../utils/format';

interface Props {
  entry: CollectionEntry<'case-studies'>;
  index: number;
  total: number;
}

const { entry, index, total } = Astro.props;
const { title, summary, tags, thumbnail, thumbnailAlt } = entry.data;
---

<article class="work-card">
  <Marquee class="work-card__marquee" text={title} repeat={4} />

  <div class="work-card__content">
    <div class="work-card__frame">
      <Image
        src={thumbnail}
        alt={thumbnailAlt}
        widths={[400, 760, 1140, 1520]}
        sizes="(min-width: 720px) 760px, 86vw"
      />
    </div>
    <div class="work-card__info">
      <h3 class="visually-hidden">{title}</h3>
      <p class="work-card__summary">{summary}</p>
      <Tag label={tags.join(' · ')} />
    </div>
  </div>

  <span class="work-card__chip work-card__index" aria-hidden="true">
    {formatCount(index, total)}
  </span>
  <span class="work-card__chip work-card__arrow" aria-hidden="true"><ArrowIcon /></span>

  <!-- The whole card is the link. -->
  <a class="work-card__link" href={`/case-studies/${entry.id}`} aria-label={`${title} — read the case study`}
  ></a>
</article>

<style lang="scss">
  @use '../../styles/mixins' as *;

  .work-card {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 100%;
    height: var(--card-height, 640px);
    overflow: hidden;
    // --surface ground that fades out at the top and bottom
    background: linear-gradient(
      180deg,
      rgba(17, 25, 35, 0) 0%,
      var(--surface) 13%,
      var(--surface) 87%,
      rgba(17, 25, 35, 0) 100%
    );
    backface-visibility: hidden;
  }

  // Display/Work Marquee: the project name behind the frame.
  .work-card__marquee {
    --marquee-duration: 88s;
    --marquee-gap: 0.5em;

    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    color: rgba(237, 241, 244, 0.92);
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    transform: translateY(-50%);

    @include mq(md) {
      font-size: 230px;
    }
  }

  .work-card__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;

    @include mq(md) {
      gap: 22px;
    }
  }

  // 16:10 frame; also limited by the card height so it fits short viewports.
  .work-card__frame {
    width: min(86vw, 760px, (var(--card-height, 640px) - 200px) * 1.6);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid rgba(237, 241, 244, 0.14);
    border-radius: 14px;
    box-shadow:
      0 40px 90px -24px rgba(0, 0, 0, 0.8),
      0 8px 24px -10px rgba(0, 0, 0, 0.6);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .work-card__info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
    max-width: min(86vw, 460px);
    text-align: center;
  }

  .work-card__summary {
    @include text-body;
    color: var(--text);
    opacity: 0.82;
  }

  .work-card__chip {
    position: absolute;
    border-radius: 999px;
  }

  .work-card__index {
    @include text-label;
    top: 30px;
    left: var(--edge);
    padding: 6px 12px;
    color: rgba(237, 241, 244, 0.94);
    background: rgba(17, 25, 35, 0.78);
    border: 1px solid rgba(237, 241, 244, 0.14);

    @include mq(md) {
      top: 40px;
    }
  }

  // Control/Arrow (Small)
  .work-card__arrow {
    top: 26px;
    right: var(--edge);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--text);
    background: rgba(17, 25, 35, 0.82);
    border: 1px solid rgba(237, 241, 244, 0.16);
    transition:
      transform 0.35s var(--ease-out),
      color 0.35s,
      background-color 0.35s;

    @include mq(md) {
      top: 36px;
    }
  }

  .work-card:hover .work-card__arrow,
  .work-card:focus-within .work-card__arrow {
    color: var(--bg);
    background: var(--text);
    transform: translate(3px, -3px);
  }

  .work-card__link {
    position: absolute;
    inset: 0;

    &:focus-visible {
      outline-offset: -6px;
    }
  }
</style>
