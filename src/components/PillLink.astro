---
/** Button/Primary: the signature CTA capsule with a green status dot. */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  label: string;
}

// `...attrs` also forwards the parent's style-scope attribute, so a parent can style the root via `class`.
const { href, label, class: className, ...attrs } = Astro.props;
---

<a class:list={['pill', className]} href={href} {...attrs}>
  <span class="pill__dot" aria-hidden="true"></span>
  {label}
</a>

<style lang="scss">
  @use '../styles/mixins' as *;

  .pill {
    @include text-button;
    display: inline-flex;
    flex: none;
    gap: 9px;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding-inline: 13px;
    color: var(--text);
    white-space: nowrap;
    background: linear-gradient(180deg, var(--surface-raised), var(--surface));
    border: 1px solid rgba(126, 157, 187, 0.4);
    border-radius: 999px;
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.3s,
      background 0.3s;

    @include mq(md) {
      padding-inline: 18px;
    }

    &:hover {
      background: var(--surface-raised);
      border-color: var(--accent-blue-text);
      transform: translateY(-1px);
    }
  }

  .pill__dot {
    width: 6px;
    height: 6px;
    background: var(--accent-green-text);
    border-radius: 50%;
  }
</style>
